{
  "name": "al1s-core",
  "version": "0.2.0",
  "private": true,
  "description": "QQ 官方机器人（QQ Open Platform）协议框架，基于 @tencent-connect/qqbot-nodejs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "qq:login": "tsx src/scripts/qq-login.ts",
    "agent:check": "tsx src/scripts/agent-check.ts",
    "agent:try": "tsx src/scripts/agent-try.ts",
    "agent:learn": "tsx --env-file=.env src/scripts/agent-learn.ts",
    "agent:stats": "tsx --env-file=.env src/scripts/agent-stats.ts",
    "agent:digest": "tsx --env-file=.env src/scripts/agent-digest.ts",
    "agent:proactive": "tsx --env-file=.env src/scripts/proactive-try.ts",
    "qq:check": "tsx src/scripts/qq-check.ts",
    "qq:panel": "tsx --env-file=.env src/scripts/qq-panel.ts",
    "deploy:server": "bash deploy/deploy-server.sh",
    "webhook:check": "tsx src/scripts/webhook-check.ts",
    "integration:check": "pnpm typecheck && pnpm build && pnpm qq:check && pnpm webhook:check",
    "ci:check": "pnpm integration:check"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "^1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
