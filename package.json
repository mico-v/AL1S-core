{
  "name": "lumabot",
  "version": "0.1.0",
  "private": true,
  "description": "A bot connecting to a SnowLuma OneBot instance via @snowluma/sdk",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "http:check": "tsx --env-file=.env src/scripts/http-check.ts",
    "llm:check": "tsx --env-file=.env src/scripts/llm-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@snowluma/sdk": "^1.14.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
