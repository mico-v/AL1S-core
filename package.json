{
  "name": "al1s-core",
  "version": "0.2.0",
  "private": true,
  "description": "QQ 官方机器人（QQ Open Platform）协议框架，基于 @tencent-connect/qqbot-nodejs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "qq:login": "tsx src/scripts/qq-login.ts",
    "qq:check": "tsx src/scripts/qq-check.ts",
    "webhook:check": "tsx src/scripts/webhook-check.ts",
    "integration:check": "pnpm typecheck && pnpm qq:check && pnpm webhook:check"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "^1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
