# ============================================================================
# QQ 官方机器人凭据（QQ 开放平台 → 机器人 → 开发设置）
# 必填。请勿提交真实密钥到仓库。
# ============================================================================
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# 事件接收方式：websocket（默认，推荐本地/无公网）| webhook
# - websocket：主动连接 QQ 网关，自动心跳 / RESUME / 重连
# - webhook  ：需要公网 HTTPS 回调地址，端口只能是 80 / 443 / 8080 / 8443
QQBOT_TRANSPORT=websocket

# 仅 webhook 模式使用
QQBOT_WEBHOOK_PORT=8080
QQBOT_WEBHOOK_PATH=/

# 自定义 intents 位掩码（可选）。不填使用 SDK FULL_INTENTS：
# GUILDS(1<<0) + GUILD_MEMBERS(1<<1) + PUBLIC_GUILD_MESSAGES(1<<30)
# + DIRECT_MESSAGE(1<<12) + GROUP_AND_C2C(1<<25) + INTERACTION(1<<26)
# 如自定义，guild 需要 1<<30，频道私信需要 1<<12；平台权限不足时网关会拒绝连接。
# QQBOT_INTENTS=

# 机器人是否拥有 Markdown 权限；影响 sendText 采用的 msg_type
QQBOT_MARKDOWN_SUPPORT=false

# 账号标识，用于日志与会话持久化；默认等于 AppID
# QQBOT_ACCOUNT_ID=

# 启动时取 token 策略：sync（默认，凭据错误立即暴露）| async
QQBOT_TOKEN_PREFETCH=sync

# 可选：覆盖 OpenAPI / token 基址，用于自建代理或测试
# QQBOT_API_BASE_URL=https://api.bot.qq.com
# QQBOT_TOKEN_BASE_URL=https://bots.qq.com

# --- 日志 ---
# 级别：debug | info | warn | error
LOG_LEVEL=info
# 是否输出到控制台
LOG_CONSOLE=true
# 落盘文件；设为 off 关闭落盘（默认 logs/bot.log）
LOG_FILE=logs/bot.log
# 单文件大小上限（MB），超过自动轮转
LOG_MAX_SIZE_MB=10
# 保留的日志文件总数（含当前文件，最小 2）
LOG_MAX_FILES=5

# --- 聊天记录 ---
# 是否按聊天目标分目录保存消息（默认开）
CHAT_LOG_ENABLED=true
# 数据根目录，聊天记录写入 <dir>/chats/
CHAT_DATA_DIR=./data
# 是否下载并保存图片/语音/视频/文件
CHAT_SAVE_MEDIA=true
# 单个媒体文件大小上限（MB），超过则跳过并记录错误
CHAT_MEDIA_MAX_MB=50

# --- Matrix bridge（可选，默认关闭）---
# 启用后使用 `pnpm bridge` 启动独立桥接服务
MATRIX_BRIDGE_ENABLED=false
# Tuwunel registration ID
MATRIX_BRIDGE_ID=al1s-qq-bridge
# Tuwunel Client-Server API 地址
MATRIX_BRIDGE_HOMESERVER_URL=http://127.0.0.1:8008
# Matrix server_name，与 Tuwunel 配置保持一致
MATRIX_BRIDGE_DOMAIN=matrix.example
# 与 Tuwunel registration 文件完全一致的共享密钥
MATRIX_BRIDGE_AS_TOKEN=
MATRIX_BRIDGE_HS_TOKEN=
# Appservice bot 与 QQ ghost 的 localpart 前缀
MATRIX_BRIDGE_SENDER_LOCALPART=_al1s_qq
MATRIX_BRIDGE_USER_PREFIX=_qq_
MATRIX_BRIDGE_ALIAS_PREFIX=_qq_
# 至少 16 字符；生产预检建议至少 32 字符。用于不可逆生成 QQ 用户和房间标识，不要轮换
MATRIX_BRIDGE_IDENTITY_SECRET=
# 允许向 QQ 转发的 Matrix 用户，逗号分隔；留空默认全部拒绝，`*` 显式允许所有用户。
# 这是部署级基线；发送者还必须是目标 QQ 房间对应的 Matrix 已加入成员。
MATRIX_BRIDGE_ALLOWED_SENDERS=
# 房间成员可转发的最低 Matrix power level，默认 0（普通成员）
MATRIX_BRIDGE_MIN_POWER_LEVEL=0
# 引用映射保留天数，默认 30；设为 0 表示不按时间过期
MATRIX_BRIDGE_REFERENCE_TTL_DAYS=30
# 引用映射最大条数，默认 10000；超出后优先删除最旧记录
MATRIX_BRIDGE_REFERENCE_MAX_ENTRIES=10000
# QQ 入站持久化队列：首次退避 5 秒，最大 5 分钟，每 5 秒检查一次
MATRIX_BRIDGE_QQ_RETRY_BASE_MS=5000
MATRIX_BRIDGE_QQ_RETRY_MAX_MS=300000
MATRIX_BRIDGE_QQ_RETRY_INTERVAL_MS=5000
# 队列上限；达到上限后新消息记录错误并丢弃
MATRIX_BRIDGE_QQ_QUEUE_MAX_ENTRIES=10000
# Appservice push 监听地址；默认仅本机可访问
MATRIX_BRIDGE_LISTEN_HOST=127.0.0.1
MATRIX_BRIDGE_PORT=29328
# bridge 状态文件
MATRIX_BRIDGE_DATA_FILE=./data/matrix-bridge/state.json
# Matrix API 超时与媒体大小上限
MATRIX_BRIDGE_REQUEST_TIMEOUT_MS=15000
MATRIX_BRIDGE_MEDIA_MAX_MB=50
# 关闭时等待 appservice 活跃连接的最长时间；应覆盖在途 Matrix 请求
MATRIX_BRIDGE_SHUTDOWN_TIMEOUT_MS=30000
