# ============================================================================
# QQ 官方机器人凭据（QQ 开放平台 → 机器人 → 开发设置）
# 必填。请勿提交真实密钥到仓库。
# ============================================================================
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# 事件接收方式：websocket（默认，推荐本地/无公网）| webhook
# - websocket：主动连接 QQ 网关，自动心跳 / RESUME / 重连
# - webhook  ：需要公网 HTTPS 回调地址，端口只能是 80 / 443 / 8080 / 8443
QQBOT_TRANSPORT=websocket

# 仅 webhook 模式使用
QQBOT_WEBHOOK_PORT=8080
QQBOT_WEBHOOK_PATH=/

# 自定义 intents 位掩码（可选）。不填使用 SDK FULL_INTENTS：
# GUILDS(1<<0) + GUILD_MEMBERS(1<<1) + PUBLIC_GUILD_MESSAGES(1<<30)
# + DIRECT_MESSAGE(1<<12) + GROUP_AND_C2C(1<<25) + INTERACTION(1<<26)
# 如自定义，guild 需要 1<<30，频道私信需要 1<<12；平台权限不足时网关会拒绝连接。
# QQBOT_INTENTS=

# 机器人是否拥有 Markdown 权限；有权限时，Markdown 正文和 QQ 提及使用 msg_type=2
QQBOT_MARKDOWN_SUPPORT=false

# 账号标识，用于日志与会话持久化；默认等于 AppID
# QQBOT_ACCOUNT_ID=

# 启动时取 token 策略：sync（默认，凭据错误立即暴露）| async
QQBOT_TOKEN_PREFETCH=sync

# 可选：覆盖 OpenAPI / token 基址，用于自建代理或测试
# QQBOT_API_BASE_URL=https://api.bot.qq.com
# QQBOT_TOKEN_BASE_URL=https://bots.qq.com

# --- 日志 ---
# 级别：debug | info | warn | error
LOG_LEVEL=info
# 是否输出到控制台
LOG_CONSOLE=true
# 落盘文件；设为 off 关闭落盘（默认 logs/bot.log）
LOG_FILE=logs/bot.log
# 单文件大小上限（MB），超过自动轮转
LOG_MAX_SIZE_MB=10
# 保留的日志文件总数（含当前文件，最小 2）
LOG_MAX_FILES=5

# --- 聊天记录 ---
# 是否按聊天目标分目录保存消息（默认开）
CHAT_LOG_ENABLED=true
# 数据根目录，聊天记录写入 <dir>/chats/
CHAT_DATA_DIR=./data
# 是否下载并保存图片/语音/视频/文件
CHAT_SAVE_MEDIA=true
# 单个媒体文件大小上限（MB），超过则跳过并记录错误
CHAT_MEDIA_MAX_MB=50

# --- 聊天 agent（LLM）---
# 关掉后机器人只记录不回复
AGENT_ENABLED=true
# OpenAI 兼容端点与模型
AGENT_API_BASE=https://opencode.ai/zen/go/v1
AGENT_API_KEY=
AGENT_MODEL=deepseek-v4.1-flash
AGENT_TEMPERATURE=0.95
AGENT_MAX_TOKENS=400
AGENT_TIMEOUT_MS=45000
# deepseek-v4.1-flash 是推理模型；闲聊关掉推理更快，
# 而且开着推理会把 max_tokens 烧光、正文变空。设 false 可以打开。
AGENT_DISABLE_THINKING=true
# 哪些 openid / 用户名算「@ 了机器人」。
# openid 是机器人在群里的 member_openid（不是 AppID），可留空先用用户名兜底。
AGENT_BOT_OPENIDS=
AGENT_BOT_USERNAMES=Kei
# 只在这些群生效；留空 = 所有群。逗号分隔的 group_openid
AGENT_GROUPS=
# 非 @ 消息留在缓冲里的条数，下次被 @ 时一起喂给模型。
# 1M 上下文下 150 条也只占 ~1%，配合提示词缓存成本很低
AGENT_CONTEXT_SIZE=150
# 主人的 openid，逗号分隔；对其语气更放松
AGENT_OWNER_OPENIDS=
# 私聊是否响应
AGENT_DIRECT_ENABLED=true
# 允许模型自主调用工具（搜历史消息 / 查群友档案 / 看群统计）
AGENT_TOOLS=true

# --- 对话归档 ---
# 群里累积多少条就压缩成一段摘要 + 话题索引；0 表示关闭
AGENT_DIGEST_THRESHOLD=40
# 单次归档最多喂多少条给模型
AGENT_DIGEST_MAX_BATCH=120
# 兜底巡检间隔：群安静下来没到阈值也会归档（毫秒，0 关闭）
AGENT_DIGEST_SWEEP_MS=600000

# --- 主动参与（默认关闭）---
# 开启后它会自己判断群聊是不是"卡住了"，只在有人提问没人接、明显说岔、
# 讨论打转这类情况下开口。判断不通过就不说话。
AGENT_PROACTIVE=false
# 只在哪些群主动（逗号分隔 group_openid）；留空 = 跟随 AGENT_GROUPS
AGENT_PROACTIVE_GROUPS=
# 两次主动发言至少隔多久（毫秒）
AGENT_PROACTIVE_COOLDOWN_MS=1800000
# 至少积累多少条消息才判断
AGENT_PROACTIVE_MIN_LINES=8
# 最后一条消息超过这么久就不接（话题凉了）
AGENT_PROACTIVE_STALE_MS=900000
# 巡检间隔（毫秒）
AGENT_PROACTIVE_INTERVAL_MS=300000

# --- AI 调用审计 ---
# 每次调用写一行 JSON（token、缓存率、耗时、速度、上下文占用、调用栈）
AGENT_CALL_LOG=true
AGENT_CALL_LOG_DIR=./data/calls
# 用来算上下文占用率；deepseek-v4.1 是 1M 上下文
AGENT_CONTEXT_WINDOW=1000000
