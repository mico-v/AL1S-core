# OneBot accessToken，来自 SnowLuma 的 OneBot 配置（没有留空即可）
SNOWLUMA_TOKEN=

# 连接端点（默认值已内置，可按需覆盖）
SNOWLUMA_HTTP_URL=http://127.0.0.1:3000/
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/

# --- LLM（OpenAI 兼容 API，可换 DeepSeek/Kimi/GLM/Qwen/本地 Ollama）---
# OpenAI 兼容端点，默认 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 不填则 llm:check 会跳过，运行时请求返回 done.error
# 请填入你自己的 API Key（不要提交真实密钥到仓库）
LLM_API_KEY=sk-在此填入你的密钥
# 模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat
# 采样温度，默认 0.7
LLM_TEMPERATURE=0.7
# 单次回复最大 token 数，默认 1024
LLM_MAX_TOKENS=1024

# --- 人设与触发 ---
# 系统人设（不填用内置默认）
BOT_PERSONA=你是一个活泼幽默的群聊 AI 机器人，说话简洁自然，用中文。
# 触发关键词，逗号分隔（@ 机器人恒触发）
TRIGGER_KEYWORDS=机器人,小助手
# 冷却秒数：机器人回复后这段时间内的触发不重复回复，默认 3
REPLY_COOLDOWN_SECONDS=3
# 上下文 token 预算，默认 3000
CONTEXT_TOKEN_BUDGET=3000
# 单次回复工具调用轮数上限，默认 5
MAX_TOOL_ITERATIONS=5
# 群白名单，逗号分隔 group_id；留空 = 全部群
ENABLED_GROUPS=
# 内存中最多缓存的会话数（LRU），默认 200
MAX_SESSIONS=200

# --- MSP AgentBridge v1：默认 rootless Podman；local-bash 仅可显式用于离线开发 ---
MSP_ENABLED=true
MSP_RUNTIME_MODE=podman
MSP_ALLOW_LOCAL_BASH_FALLBACK=false
MSP_CONTAINER_IMAGE=al1s-sandbox:latest
MSP_WORKSPACE_ROOT=./data/msp-workspace
MSP_SHELL=/bin/bash
MSP_MAX_LIVE_SESSIONS=64
MSP_DEFAULT_YIELD_TIME_MS=10000
MSP_MAX_YIELD_TIME_MS=30000
MSP_EMPTY_POLL_MS=5000
MSP_MAX_EMPTY_POLL_MS=300000
MSP_MAX_OUTPUT_TOKENS=10000
MSP_MAX_OUTPUT_BYTES=40000
MSP_FORMAT_OUTPUT=true
MSP_TIMEOUT_MS=120000
# 启动时默认跳过构建，避免嵌套 Podman 网络超时阻塞 Bot；运行时仍保持 fail-closed
MSP_SANDBOX_BOOTSTRAP=false
# 默认 false：Podman/镜像不可用时 Bot 仍启动，但拒绝执行 sandbox 命令
MSP_SANDBOX_FAIL_FAST=false


SHELL_ENABLED=false
# $ 命令与 Agent exec_command 共用 SessionCommandRunner；不要改为宿主 bash
SHELL_RUNTIME=local
# 固定工作目录；不接受 agent 传入 cwd
SHELL_CWD=.
# 聊天命令触发前缀；管理员发送 "$<命令>"，默认 $
SHELL_TRIGGER_PREFIX=$
# 留空表示开发阶段不限制命令；填写后收紧命令范围
SHELL_ALLOWLIST=
SHELL_DENYLIST=
SHELL_TIMEOUT_MS=10000
SHELL_MAX_OUTPUT_BYTES=32000
# 留空时回退 BOT_ADMINS；BOT_ADMINS 为空则 shell 拒绝调用
SHELL_ADMIN_IDS=
SHELL_SCRUB_ENV=true


# 日志级别：debug|info|warn|error，调试时设 debug
LOG_LEVEL=info
# 留空=仅终端；填绝对路径则同时追加写文件（启动时自动按大小轮转，最多保留一份 .1）
LOG_FILE=
# 日志文件轮转阈值（MB），默认 10
LOG_MAX_SIZE_MB=10

# --- 管理后台（Web 管理界面）---
# 管理 token：不配置则不开管理服务；前端登录页输入此值
ADMIN_TOKEN=
# 管理服务端口，默认 6185；默认只监听 127.0.0.1（容器内配 0.0.0.0 以配合端口映射）
ADMIN_PORT=6185
ADMIN_HOST=127.0.0.1

# --- AL1S 格式化（加在 LLM 回复管线上的可开关格式化层，默认全关）---
# 总开关：开启后 LLM 输出先做 Markdown 清理
AL1S_FORMAT_ENABLED=false
# 对所有最终文本清理 Markdown（含命令回复）
AL1S_GLOBAL_MARKDOWN_KILLER=false
# 按空行/标题/表格结构分段发送
AL1S_LLM_LINE_SPLIT=false
# 分段发送字数/秒（越小间隔越长），默认 80
AL1S_SPLIT_CHARS_PER_SECOND=80
# 单段最小/最大延时（秒）
AL1S_SPLIT_MIN_SECONDS=0.5
AL1S_SPLIT_MAX_SECONDS=3.0

# --- 通用管理员（逗号 QQ 号；留空 = 不限制，管理员命令对所有人开放）---
BOT_ADMINS=

# --- 课程表插件 ---
# 本地数据文件路径，默认 ./data/course-schedule.json
COURSE_DATA_FILE=./data/course-schedule.json
# 群文件课表目录名，默认 schedule
COURSE_ICS_FOLDER=schedule
# 中文字体路径（渲染课表图片用）；留空则按系统字体/插件字体自动查找
COURSE_FONT_PATH=

# --- XXT 课堂提醒 ---
# 上课时段，逗号分隔，格式 "08:30-10:00:课程名"
XXT_CLASS_PERIODS=
# 对同一发言人重复提醒的冷却秒数，默认 60
XXT_CLASS_WARNING_COOLDOWN_SECONDS=60
# 被 @ 后未回复的判定超时（秒），默认 60
XXT_CLASS_REPLY_TIMEOUT_SECONDS=60
