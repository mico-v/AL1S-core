# OneBot accessToken，来自 SnowLuma 的 OneBot 配置（没有留空即可）
SNOWLUMA_TOKEN=

# 连接端点（默认值已内置，可按需覆盖）
SNOWLUMA_HTTP_URL=http://127.0.0.1:3000/
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/

# --- LLM（OpenAI 兼容 API，可换 DeepSeek/Kimi/GLM/Qwen/本地 Ollama）---
# OpenAI 兼容端点，默认 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 不填则 llm:check 会跳过，运行时请求返回 done.error
LLM_API_KEY=sk-在此填入你的密钥
# 模型名，默认 deepseek-chat
LLM_MODEL=deepseek-chat
# 采样温度，默认 0.7
LLM_TEMPERATURE=0.7
# 单次回复最大 token 数，默认 1024
LLM_MAX_TOKENS=1024

# --- 人设与触发 ---
# 系统人设（不填用内置默认）
BOT_PERSONA=你是一个活泼幽默的群聊 AI 机器人，说话简洁自然，用中文。
# 触发关键词，逗号分隔（@ 机器人恒触发）
TRIGGER_KEYWORDS=机器人,小助手
# 冷却秒数：机器人回复后这段时间内的触发不重复回复，默认 3
REPLY_COOLDOWN_SECONDS=3
# 上下文 token 预算，默认 3000
CONTEXT_TOKEN_BUDGET=3000
# 单次回复工具调用轮数上限，默认 5
MAX_TOOL_ITERATIONS=5
# 群白名单，逗号分隔 group_id；留空 = 全部群
ENABLED_GROUPS=
# 内存中最多缓存的会话数（LRU），默认 200
MAX_SESSIONS=200

# --- 日志 ---
# 日志级别：debug|info|warn|error，调试时设 debug
LOG_LEVEL=info
# 留空=仅终端；填绝对路径则同时追加写文件（启动时自动按大小轮转，最多保留一份 .1）
LOG_FILE=
# 日志文件轮转阈值（MB），默认 10
LOG_MAX_SIZE_MB=10
