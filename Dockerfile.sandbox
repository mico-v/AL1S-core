# Session sandbox image. It contains only the runtimes and registered CLI entrypoint.
FROM node:24-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python-is-python3 ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 --shell /bin/bash al1s \
 && mkdir -p /app /run/al1s \
 && chown -R al1s:al1s /app /run/al1s

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY tsconfig.json ./
RUN chown -R al1s:al1s /app

ENV HOME=/home/al1s \
    TMPDIR=/tmp \
    MSP_RUNTIME_MODE=local-bash \
    NODE_ENV=production
USER al1s
